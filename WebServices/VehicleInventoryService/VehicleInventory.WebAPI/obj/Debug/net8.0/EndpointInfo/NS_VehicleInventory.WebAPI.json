{
  "openapi": "3.0.1",
  "info": {
    "title": "NS_VehicleInventory.WebAPI",
    "version": "1.0"
  },
  "paths": {
    "/api/vehicles": {
      "get": {
        "tags": [
          "NS_Vehicle"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "NS_Vehicle"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NS_CreateVehicleRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/NS_CreateVehicleRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/NS_CreateVehicleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/vehicles/{id}": {
      "get": {
        "tags": [
          "NS_Vehicle"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "tags": [
          "NS_Vehicle"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/vehicles/{id}/status": {
      "put": {
        "tags": [
          "NS_Vehicle"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NS_UpdateStatusRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/NS_UpdateStatusRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/NS_UpdateStatusRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NS_CreateVehicleRequest": {
        "required": [
          "locationId",
          "vehicleCode",
          "vehicleType"
        ],
        "type": "object",
        "properties": {
          "vehicleCode": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "locationId": {
            "type": "string",
            "format": "uuid"
          },
          "vehicleType": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "NS_UpdateStatusRequest": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/VehicleStatus"
          }
        },
        "additionalProperties": false
      },
      "VehicleStatus": {
        "enum": [
          "Available",
          "Reserved",
          "Rented",
          "Serviced"
        ],
        "type": "string"
      }
    }
  }
}