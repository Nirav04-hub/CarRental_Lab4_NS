{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "maintenance-route": {
        "ClusterId": "maintenance-cluster",
        "Match": {
          "Path": "/maintenance-service/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      "customerprofile-route": {
        "ClusterId": "customerprofile-cluster",
        "Match": {
          "Path": "/customerprofile-service/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/inventory-service/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "maintenance-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7267/"
          }
        }
      },
      "customerprofile-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:CUSTOMERPROFILE_PORT/"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:INVENTORY_PORT/"
          }
        }
      }
    }
  }
}
